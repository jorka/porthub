{
  "name": "porthub-monorepo",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/vscode"
  ],
  "scripts": {
    "build": "npm run build -w porthub",
    "typecheck": "tsc -p packages/core && tsc -p packages/vscode",
    "test": "vitest run",
    "test:integration": "npm run test:integration -w porthub",
    "package": "npm run package -w porthub"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8",
    "diff": "^8.0.3",
    "serialize-javascript": "^7.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
